# Copy to your shell environment (ThirdSeat does not read .env files itself).
# AI mode is opt-in: conversation snippets are sent to Anthropic when enabled.
THIRDSEAT_LLM=off            # set to "anthropic" to enable
ANTHROPIC_API_KEY=
THIRDSEAT_MODEL=claude-opus-5-5
THIRDSEAT_WEB_SEARCH=1
THIRDSEAT_LLM_FALLBACKS=1
THIRDSEAT_DOCS_DIR=
THIRDSEAT_LOG_CONTENT=0
THIRDSEAT_SESSION_TTL_HOURS=12
# Live audio: server speech-to-text (opt-in; meeting audio is sent to Deepgram)
THIRDSEAT_STT=off            # set to "deepgram" to enable
DEEPGRAM_API_KEY=
THIRDSEAT_STT_MODEL=nova-3
THIRDSEAT_STT_LANGUAGE=en
# Voice participation: optional server voice (otherwise the browser's voices speak)
THIRDSEAT_TTS=off            # set to "deepgram" (uses DEEPGRAM_API_KEY)
THIRDSEAT_TTS_VOICE=aura-2-thalia-en
PORT=4317
HOST=127.0.0.1
