# Copy to your shell environment (ThirdSeat does not read .env files itself).
# AI mode is opt-in: conversation snippets are sent to Anthropic when enabled.
THIRDSEAT_LLM=off            # set to "anthropic" to enable
ANTHROPIC_API_KEY=
THIRDSEAT_MODEL=claude-opus-5-5
THIRDSEAT_WEB_SEARCH=1
THIRDSEAT_LLM_FALLBACKS=1
THIRDSEAT_DOCS_DIR=
THIRDSEAT_LOG_CONTENT=0
THIRDSEAT_SESSION_TTL_HOURS=12
PORT=4317
HOST=127.0.0.1
